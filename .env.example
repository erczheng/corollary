# Alpaca ??? paper
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Alpaca ??? live (blank until Phase 7)
# ALPACA_LIVE_API_KEY=
# ALPACA_LIVE_SECRET_KEY=

# Options
ALPACA_OPTIONS_FEED=

# Equities
ALPACA_STOCK_FEED_HISTORICAL=
ALPACA_STOCK_FEED_REALTIME=

# Which Alpaca data plan this account is on: basic | algo_trader_plus.
# A fact about the account, not a preference -- you cannot select your way
# onto OPRA. Settings reads it to decide which feed values may be chosen.
# Unset reads as `basic`, which is the restrictive direction: the failure
# is a refused upgrade you have actually bought, never a feed nobody paid
# for being stored and then 403ing mid-poll.
ALPACA_DATA_PLAN=

# LLM layer + Research chat
ANTHROPIC_API_KEY=

# Context data
MASSIVE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
# OpenFIGI (ISIN -> ticker for N-PORT lines with no CUSIP). OPTIONAL: unset means the
# keyless limits (25 req/min, 10 ISINs a request), not an error. Sent only as the
# X-OPENFIGI-APIKEY header; never logged, redacted from every error.
OPENFIGI_API_KEY=
DISCORD_WEBHOOK_URL=

# SEC EDGAR fair-access User-Agent, required form "Name email" -- the owner's
# declared identity, treated as a secret: never logged, never in a fixture.
# The value MUST be quoted because it contains spaces. Unquoted, uv's
# --env-file parser rejects the line and prints the whole line to stderr.
# Unset -> the SEC job skips (and tests/fixtures/record_sec.py refuses to run).
# Example shape: SEC_USER_AGENT="Jane Doe jane@example.com"
SEC_USER_AGENT=

# Local database (optional -- defaults to ./corollary.db)
COROLLARY_DATABASE_URL=
